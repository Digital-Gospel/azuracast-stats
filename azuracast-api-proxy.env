# ============================================================
# AzuraCast API Proxy — konfiguracja
# ============================================================
# Skopiuj ten plik jako azuracast-api-proxy.env do katalogu
# POZA document root (np. /etc/azuracast/ lub jeden poziom wyżej)
# i ustaw uprawnienia: chmod 640, chown www-data:www-data
#
# Ścieżkę do tego pliku podaj w zmiennej środowiskowej:
#   SetEnv AZURACAST_PROXY_ENV /etc/azuracast/azuracast-api-proxy.env
# lub wczytaj bezpośrednio przez PHP_ENV / docker-compose env_file.
# ============================================================

# ── Wymagane ────────────────────────────────────────────────

# Klucz API AzuraCast (tylko do odczytu — nie używaj klucza admin)
AZURACAST_API_KEY=your-api-key-here

# Bazowy URL API (bez trailing slash)
AZURACAST_BASE_URL=https://player.legnica.fm/api

# ID stacji (liczba całkowita)
AZURACAST_STATION_ID=1

# Fetch and follow the existing-widget flow:
# https://developers.cloudflare.com/turnstile/spin/prompt.md
TURNSTILE_SECRET_KEY=your-key-here

# ── Logowanie ───────────────────────────────────────────────

# Tryb logowania: standard | debug | off
#   standard  — błędy, ostrzeżenia, dostępy 403/4xx
#   debug     — wszystkie requesty, odpowiedzi upstream, timing
#   off       — brak logowania (niezalecane na produkcji)
LOG_LEVEL=debug

# Ścieżka do pliku logu (musi być zapisywalna przez www-data)
# Ustaw poza document root!
LOG_FILE=./azuracast-api-proxy.log

# ── Rate limiting ────────────────────────────────────────────

# Maksymalna liczba requestów na IP na minutę (0 = wyłączony)
RATE_LIMIT_RPM=120

# Katalog na pliki stanu rate limitera (musi być zapisywalny)
RATE_LIMIT_DIR=/tmp/azuracast-api-proxy.rl

# ── Timeouty cURL ────────────────────────────────────────────

# Czas na nawiązanie połączenia TCP (sekundy)
CURL_CONNECT_TIMEOUT=5

# Całkowity timeout requestu (sekundy)
CURL_TIMEOUT=15

# ── Bezpieczeństwo ───────────────────────────────────────────

# Dozwolony Origin dla CORS (pusta wartość = wyłączone; * = wszystkie — niezalecane)
# Ustaw pełny origin swojej domeny, np. https://biblia.info.pl
ALLOWED_ORIGIN=https://saturn.legnica.fm
