# ============================================================
# AzuraCast Analytics Dashboard — server configuration
# ============================================================
# Copy this file to a private location outside the web document root.
#
# Recommended:
#   /etc/azuracast-analytics/azuracast-api-proxy.env
#
# Point PHP to the file with:
#   AZURACAST_PROXY_ENV=/etc/azuracast-analytics/azuracast-api-proxy.env
#
# Never commit the real configuration file to Git.
# ============================================================

# --- Required -------------------------------------------------

# AzuraCast API key with the minimum read-only permissions required
# by the endpoints exposed by the proxy.
AZURACAST_API_KEY=CHANGE_ME

# Base URL of the AzuraCast API, without a trailing slash.
AZURACAST_BASE_URL=https://your-azuracast.example/api

# Integer station ID. Must match js/config.js.
AZURACAST_STATION_ID=1

# Cloudflare Turnstile secret key (server-side only).
TURNSTILE_SECRET_KEY=CHANGE_ME

# Optional but recommended. Validates the hostname returned by Turnstile.
# Example:
# TURNSTILE_EXPECTED_HOSTNAME=stats.example.com
TURNSTILE_EXPECTED_HOSTNAME=

# --- Logging --------------------------------------------------

# standard | debug | off
LOG_LEVEL=standard

# Keep the log outside the web document root.
LOG_FILE=/var/log/azuracast-analytics/azuracast-api-proxy.log

# --- Rate limiting -------------------------------------------

# Maximum requests per IP per 60-second window.
RATE_LIMIT_RPM=120

# Directory for rate-limit state. It must be writable by PHP.
RATE_LIMIT_DIR=/run/azuracast-analytics-rate-limit

# --- Timeouts -------------------------------------------------

# TCP connection timeout, seconds.
CURL_CONNECT_TIMEOUT=5

# Total upstream request timeout, seconds.
CURL_TIMEOUT=15

# Turnstile site verification timeout, seconds.
TURNSTILE_VERIFY_TIMEOUT=10

# How long a successful Turnstile verification remains valid, seconds.
TURNSTILE_SESSION_TTL=3600

# --- CORS -----------------------------------------------------

# Leave empty for same-origin deployment (recommended).
# Set an exact origin only when cross-origin browser access is required.
ALLOWED_ORIGIN=
